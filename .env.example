# Server-only KOBIS access key. Do not add NEXT_PUBLIC_ to this name.
KOBIS_API_KEY=

# Server-only Supabase secret key. Do not add NEXT_PUBLIC_ to this name.
SUPABASE_SECRET_KEY=

# Supabase project URL. It can be used by server-side code only until a public client is required.
SUPABASE_URL=

# demo uses local fixture data only. live is reserved for the later server API integration.
DATA_MODE=demo
